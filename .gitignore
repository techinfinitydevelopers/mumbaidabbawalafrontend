# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superseded design explorations (regenerable; kept locally, not worth repo weight)
/design-assets/superseded/

# client source documents — kept local, not for a public repo
*.pdf
# one-off asset scripts run by hand; the outputs they produce are committed
/scratchpad/
# third-party reference clipart used only as a visual spec; the mark itself is drawn
# in VegMark.tsx, so this file is not needed to build the site
/design-assets/brand/veg-nonveg-mark-reference.jpg
